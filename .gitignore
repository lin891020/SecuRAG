# Build logs. One of these was committed in April: 146 KB of UTF-16
# PowerShell output, the largest file in the repository, at its root.
build_log.txt
*.build.log

# vue-tsc -b writes this next to tsconfig.json; `npm run build` leaves it behind.
*.tsbuildinfo
