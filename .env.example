# Database
SECURAG_DATABASE_URL=postgresql+asyncpg://securag:securag@postgres:5432/securag

# ChromaDB
SECURAG_CHROMA_HOST=chromadb
SECURAG_CHROMA_PORT=8000
SECURAG_CHROMA_COLLECTION=securag_docs

# LLM Provider: "ollama" or "vertexai"
SECURAG_LLM_PROVIDER=ollama
SECURAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
SECURAG_OLLAMA_MODEL=llama3.2

# Vertex AI (only if SECURAG_LLM_PROVIDER=vertexai)
SECURAG_GCP_PROJECT=
SECURAG_GCP_REGION=us-central1
SECURAG_VERTEXAI_MODEL=gemini-1.5-flash

# Embeddings
SECURAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Guardrails
SECURAG_GUARDRAILS_ENABLED=true
SECURAG_GUARDRAILS_CONFIG_PATH=app/guardrails/config

# RAG
SECURAG_CHUNK_SIZE=1000
SECURAG_CHUNK_OVERLAP=200
SECURAG_RETRIEVAL_TOP_K=5

# CORS (comma-separated origins)
SECURAG_CORS_ORIGINS=http://localhost:8311
